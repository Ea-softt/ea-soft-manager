{
  "name": "ea-soft-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "EA-Soft hotspot customer, voucher, and finance manager",
  "author": "EA-Soft",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:start": "npm run build && node scripts/start-desktop.cjs",
    "desktop:smoke": "npm run build && node scripts/start-desktop.cjs --smoke-test",
    "desktop:build": "npm run build && node -e \"require('electron')\" && electron-builder --win --x64",
    "cap:sync": "npm run build && cap sync",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "android:build": "npm run cap:sync && android\\gradlew.bat -p android :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0"
  }
}
